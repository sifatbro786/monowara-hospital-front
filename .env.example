# Data layer switch — "static" reads data/*.js (Vercel demo), "api" calls mh-back (B3, local + VPS)
DATA_SOURCE=static
# Local dev: 127.0.0.1, not "localhost" (Node may resolve ::1 and the API binds IPv4 loopback only).
# VPS: the Next server calls the API directly on loopback (no Nginx hop, exempt from the rate limit):
#   API_URL=http://127.0.0.1:5020/api        (public URL for browsers: https://api.monowarahospital.com/api)
API_URL=http://127.0.0.1:5020/api

# Only the real VPS deploy should be "production" (enables indexing + sitemap in robots.txt)
NEXT_PUBLIC_SITE_ENV=demo
NEXT_PUBLIC_SITE_URL=https://monowara-hospital.vercel.app

# Shown only by app/global-error.js when the site can't load settings (keep in sync with Settings)
NEXT_PUBLIC_FALLBACK_HOTLINE=09611622333
NEXT_PUBLIC_FALLBACK_EMERGENCY=01789446240

# API mode only (VPS). Origin Nginx serves /uploads from — makes uploaded images absolute so next/image
# fetches them through Nginx (files uploaded after the Next server started are otherwise 404).
# MEDIA_ORIGIN=https://monowarahospital.com
# API_TIMEOUT_MS=8000

# Admin dashboard (/admin) → mh-back, called from the BROWSER with cookies. Must be the same *site* as the
# page (SameSite=Strict): VPS https://api.monowarahospital.com/api. Local: a loopback host follows the
# name you opened the site with (localhost ↔ 127.0.0.1), so either works. The origin you open the
# dashboard on must be in mh-back CORS_ORIGINS.
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:5036/api

# ── B3 ──
# Browser → API for the public forms (contact, appointment request, CV upload) and the tap beacon.
# Empty → falls back to NEXT_PUBLIC_ADMIN_API_URL; both empty (Vercel demo) → forms use WhatsApp/email.
# Inlined at BUILD time. VPS: https://api.monowarahospital.com/api
NEXT_PUBLIC_API_URL=
# mh-back → POST /api/revalidate after every admin save (header x-revalidate-secret). Same value as
# REVALIDATE_SECRET in mh-back/.env, ≥ 32 random chars. Empty → the route refuses every call.
REVALIDATE_SECRET=
