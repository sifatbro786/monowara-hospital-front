# Data layer switch — "static" reads data/*.js (Vercel demo), "api" calls mh-api (after design lock)
DATA_SOURCE=static
API_URL=http://localhost:5020/api/v1

# Only the real VPS deploy should be "production" (enables indexing + sitemap in robots.txt)
NEXT_PUBLIC_SITE_ENV=demo
NEXT_PUBLIC_SITE_URL=https://monowara-hospital.vercel.app
